{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "sqotion",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "sqotion",
      "remote" : true
    },
  ],
}

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NoteHeader from "@/components/NoteHeader.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ImageZoom from "@/components/ImageZoom.astro";
import type { Note } from "@/lib/notes";
import "katex/dist/katex.min.css";

interface Props {
	note: Note;
}

const { note } = Astro.props;
const { title, description, html, headings } = note;

// Breadcrumb from note id
const segments = note.id.split("/").filter(Boolean);
const breadcrumbs = segments.map((seg, i) => ({
	name: seg,
	path: "/" + segments.slice(0, i + 1).join("/"),
	isLast: i === segments.length - 1,
}));
---

<BaseLayout
  title={title}
  description={description}
  withSidebar={true}
  currentSlug={note.id}
>
  <!-- Left sidebar is handled by BaseLayout -->

  <!-- Center content -->
  <article
    class="mx-auto min-w-0 flex-1 px-4 py-10 lg:px-8 xl:px-12"
    style="max-width: 820px;"
  >
    <!-- Breadcrumbs -->
    {breadcrumbs.length > 0 && (
      <nav class="mb-6 flex flex-wrap items-center gap-1 text-sm text-neutral-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-neutral-900 dark:hover:text-neutral-100">Home</a>
        {breadcrumbs.map((crumb) => (
          <>
            <span aria-hidden="true" class="text-neutral-300 dark:text-neutral-700">/</span>
            {crumb.isLast ? (
              <span class="capitalize text-neutral-900 dark:text-neutral-100">{crumb.name}</span>
            ) : (
              <a
                href={crumb.path}
                class="capitalize hover:text-neutral-900 dark:hover:text-neutral-100"
              >
                {crumb.name}
              </a>
            )}
          </>
        ))}
      </nav>
    )}

    <NoteHeader note={note} />
    <div class="note-body mt-10" set:html={html} />
  </article>

  <!-- Right TOC -->
  <aside slot="toc">
    <div class="sticky top-20">
      <TableOfContents headings={headings} />
    </div>
  </aside>

  <ImageZoom />
</BaseLayout>

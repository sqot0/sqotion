---
import ThemeToggle from "@/components/ThemeToggle.astro";
import Sidebar from "@/components/Sidebar.astro";
import SidebarScript from "@/components/SidebarScript.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import { buildSubjectTree, getNotes, type SubjectNode } from "@/lib/notes";
import { Font } from "astro:assets";
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
	/** Whether to show the full layout with sidebars (true) or just header (false) */
	withSidebar?: boolean;
	/** Whether to show the table of contents column (defaults to withSidebar) */
	withToc?: boolean;
	/** Current note slug for sidebar active highlighting */
	currentSlug?: string;
}

const {
	title = "Sqotion",
	description = "",
	withSidebar = false,
	withToc = withSidebar,
	currentSlug,
} = Astro.props;

let sidebarTree: SubjectNode[] = [];
if (withSidebar) {
	const notes = await getNotes();
	sidebarTree = buildSubjectTree(notes);
}
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <PagefindConfig instance="pagefind" lang="pl" preload={false} />
    <Font cssVariable="--font-inter" />
  </head>
  <body
    class="min-h-screen bg-white font-sans text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100"
  >
    <ReadingProgress />

    <!-- Header -->
    <header
      class="sticky top-0 z-40 border-b border-neutral-200 bg-white/80 backdrop-blur-md dark:border-neutral-800 dark:bg-neutral-950/80"
    >
      <div class="mx-auto flex h-14 max-w-360 items-center gap-4 px-4">
        <!-- Logo / Home -->
        <a href="/" class="shrink-0 text-base font-semibold tracking-tight">
          Sqotion
        </a>

        <div class="flex-1"></div>

        <!-- Desktop search -->
        <div class="hidden sm:block">
          <pagefind-searchbox></pagefind-searchbox>
        </div>

        <ThemeToggle />

        <!-- Mobile menu buttons -->
        {
          withSidebar && (
            <>
              <button
                type="button"
                id="open-sidebar-button"
                class="rounded-md p-2 text-neutral-600 hover:bg-neutral-100 lg:hidden dark:text-neutral-400 dark:hover:bg-neutral-800"
                aria-label="Open sidebar"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="3" y1="12" x2="21" y2="12" />
                  <line x1="3" y1="6" x2="21" y2="6" />
                  <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
              </button>
              {withToc && (
                <button
                  type="button"
                  id="open-toc-button"
                  class="rounded-md p-2 text-neutral-600 hover:bg-neutral-100 lg:hidden dark:text-neutral-400 dark:hover:bg-neutral-800"
                  aria-label="Open table of contents"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <line x1="3" y1="6" x2="3.01" y2="6" />
                    <line x1="3" y1="12" x2="3.01" y2="12" />
                    <line x1="3" y1="18" x2="3.01" y2="18" />
                  </svg>
                </button>
              )}
            </>
          )
        }
      </div>
    </header>

    <!-- Desktop 3-column layout + mobile drawers -->
    <div class="lg:flex lg:items-start">
      <!-- Mobile sidebar drawer / desktop left sidebar -->
      {
        withSidebar && (
          <>
            <div
              id="sidebar-backdrop"
              class="hidden fixed inset-0 z-40 drawer-backdrop lg:hidden"
              onclick="closeSidebar()"
            />
            <aside
              id="sidebar-drawer"
              class="fixed inset-y-0 left-0 z-50 w-72 transform border-r border-neutral-200 bg-white p-4 transition-transform duration-300 -translate-x-full overflow-y-auto lg:static lg:z-0 lg:translate-x-0 lg:w-72 lg:shrink-0 lg:border-r dark:border-neutral-800 dark:bg-neutral-950"
            >
              <div class="mb-4 flex items-center justify-between lg:hidden">
                <span class="text-sm font-semibold">Navigation</span>
                <button
                  type="button"
                  onclick="closeSidebar()"
                  class="rounded-md p-1 text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-800"
                  aria-label="Close sidebar"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
              <Sidebar tree={sidebarTree} currentSlug={currentSlug} />
            </aside>
          </>
        )
      }

      <!-- Center content -->
      <main class="w-full min-w-0 lg:flex-1">
        <slot />
      </main>

      <!-- Mobile TOC drawer / desktop right TOC -->
      {
        withSidebar && withToc && (
          <>
            <div
              id="toc-backdrop"
              class="hidden fixed inset-0 z-40 drawer-backdrop lg:hidden"
              onclick="closeToc()"
            />
            <aside
              id="toc-drawer"
              class="fixed inset-y-0 right-0 z-50 w-72 transform border-l border-neutral-200 bg-white p-4 transition-transform duration-300 translate-x-full overflow-y-auto lg:static lg:z-0 lg:translate-x-0 lg:w-72 lg:shrink-0 lg:border-l dark:border-neutral-800 dark:bg-neutral-950"
            >
              <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-semibold">On this page</span>
                <button
                  type="button"
                  onclick="closeToc()"
                  class="rounded-md p-1 text-neutral-500 hover:bg-neutral-100 lg:hidden dark:hover:bg-neutral-800"
                  aria-label="Close table of contents"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
              <slot name="toc" />
            </aside>
          </>
        )
      }
    </div>

    <SidebarScript />

    <!-- Mobile drawer + search helpers -->
    <script>
      function hideEl(el: HTMLElement, hidden: boolean) {
        if (hidden) {
          el.classList.add("hidden");
        } else {
          el.classList.remove("hidden");
        }
      }

      function openSidebar() {
        const drawer = document.getElementById("sidebar-drawer");
        const backdrop = document.getElementById("sidebar-backdrop");
        if (drawer) {
          drawer.classList.add("lg:translate-x-0", "translate-x-0");
          drawer.classList.remove("-translate-x-full");
        }
        if (backdrop) hideEl(backdrop, false);
        document.body.classList.add("overflow-hidden", "lg:overflow-auto");
      }

      function closeSidebar() {
        const drawer = document.getElementById("sidebar-drawer");
        const backdrop = document.getElementById("sidebar-backdrop");
        if (drawer) {
          drawer.classList.add("-translate-x-full");
          drawer.classList.remove("translate-x-0");
        }
        if (backdrop) hideEl(backdrop, true);
        document.body.classList.remove("overflow-hidden", "lg:overflow-auto");
      }

      function openToc() {
        const drawer = document.getElementById("toc-drawer");
        const backdrop = document.getElementById("toc-backdrop");
        if (drawer) {
          drawer.classList.add("translate-x-0");
          drawer.classList.remove("translate-x-full");
        }
        if (backdrop) hideEl(backdrop, false);
        document.body.classList.add("overflow-hidden", "lg:overflow-auto");
      }

      function closeToc() {
        const drawer = document.getElementById("toc-drawer");
        const backdrop = document.getElementById("toc-backdrop");
        if (drawer) {
          drawer.classList.add("translate-x-full");
          drawer.classList.remove("translate-x-0");
        }
        if (backdrop) hideEl(backdrop, true);
        document.body.classList.remove("overflow-hidden", "lg:overflow-auto");
      }

      function openSearch() {
        const box = document.querySelector("pagefind-searchbox");
        if (box) {
          const input = box.querySelector(
            "input[type='search'], [data-pagefind-search]",
          );
          if (input) {
            (input as HTMLElement).focus();
            (input as HTMLInputElement).select?.();
            return;
          }
        }
        // Fallback: expose pagefind UI API if available
        const ui = (window as unknown as Record<string, unknown>)["pagefindUI"] as
          | { search?: (q?: string) => void }
          | undefined;
        ui?.search?.("");
      }

      // Make helpers available globally for inline onclick handlers
      const g = window as unknown as Record<string, unknown>;
      g.openSidebar = openSidebar;
      g.closeSidebar = closeSidebar;
      g.openToc = openToc;
      g.closeToc = closeToc;
      g.openSearch = openSearch;

      // Wire up header open buttons (mobile)
      document
        .getElementById("open-sidebar-button")
        ?.addEventListener("click", openSidebar);
      document
        .getElementById("open-toc-button")
        ?.addEventListener("click", openToc);

      // Close drawers when a navigation link or backdrop is tapped (mobile)
      document.addEventListener("click", (e) => {
        const target = e.target as Element;
        if (target && target.closest("#sidebar-drawer a, #toc-drawer a")) {
          closeSidebar();
          closeToc();
        }
        if (target && target.closest("#sidebar-backdrop, #toc-backdrop")) {
          closeSidebar();
          closeToc();
        }
      });
    </script>

    <div class="fixed bottom-4 right-4 z-30 sm:hidden">
      <pagefind-modal-trigger hide-shortcut="true" compact="true"></pagefind-modal-trigger>
      <pagefind-modal></pagefind-modal>
    </div>
  </body>
</html>

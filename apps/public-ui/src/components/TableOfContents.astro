---
import type { Heading } from "@/lib/notes";

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
---

<nav class="space-y-0.5" aria-label="Table of contents">
  {
    headings.length === 0 ? (
      <p class="text-xs text-neutral-400">No headings found</p>
    ) : (
      headings.map((heading) => (
        <a
          href={`#${heading.slug}`}
          class="block rounded-md py-1 text-sm text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100 toc-link"
          style={`padding-left: ${(heading.level - 2) * 0.75 + 0.5}rem`}
          data-toc-slug={heading.slug}
        >
          {heading.text}
        </a>
      ))
    )
  }
</nav>

<script>
  // Highlight active TOC link on scroll
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const slug = entry.target.id;
        const link = document.querySelector(`[data-toc-slug="${slug}"]`);
        if (link) {
          if (entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove("toc-link-active"));
            link.classList.add("toc-link-active");
          }
        }
      }
    },
    { rootMargin: "-80px 0px -80% 0px" },
  );

  for (const link of tocLinks) {
    const id = link.getAttribute("data-toc-slug");
    if (id) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  }
</script>

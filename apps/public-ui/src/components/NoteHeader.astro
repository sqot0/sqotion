---
import type { Note } from "@/lib/notes";

interface Props {
	note: Note;
}

const { note } = Astro.props;
const { title, description, createdDate, updatedDate } = note;
---

<header class="border-b border-neutral-200 pb-8 dark:border-neutral-800">
  <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
  {description && (
    <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">
      {description}
    </p>
  )}
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-neutral-500">
    <time datetime={createdDate.toISOString()}>
      Created {createdDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
    </time>
    {updatedDate && (
      <>
        <span aria-hidden="true">·</span>
        <time datetime={updatedDate.toISOString()}>
          Updated {updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </>
    )}
  </div>
</header>
